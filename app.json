{
  "expo": {
    "name": "Athletics Department",
    "slug": "athletics-department",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "athleticsdept",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D10",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.athleticsdepartment.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Athletics Department uses the camera to scan coach invite QR codes and capture progress photos.",
        "NSPhotoLibraryUsageDescription": "Athletics Department needs photo library access so you can attach progress and check-in photos.",
        "NSMicrophoneUsageDescription": "Athletics Department uses the microphone when recording exercise demo videos."
      }
    },
    "android": {
      "package": "com.athleticsdepartment.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-camera",
      "expo-video",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
